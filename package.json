{
  "name": "4shadow-js",
  "private": true,
  "description": "JavaScript SDK and map lab for the 4Shadow weather forecast API",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/sdk",
    "build:lab": "npm run build -w packages/sdk && npm run build -w apps/map-lab",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "lab": "npm run dev -w apps/map-lab",
    "tunnel": "npm run tunnel -w apps/map-lab",
    "screenshots": "node apps/map-lab/scripts/screenshots.mjs --out docs/images"
  },
  "engines": {
    "node": ">=22.17"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2"
  }
}
