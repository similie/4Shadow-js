{
  "name": "@similie/4shadow",
  "version": "0.2.0",
  "description": "Weather forecast API client for JavaScript and TypeScript: global point forecasts by place name or coordinates, place search, map tiles, raw gridded fields for WebGL weather maps, and early-warning alerts with signed webhooks. NOAA GFS data through 4Shadow.",
  "license": "MIT",
  "author": "Similie (https://similie.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "weather",
    "weather-api",
    "weather-forecast",
    "forecast",
    "gfs",
    "noaa",
    "maplibre",
    "webgl",
    "wind",
    "waves",
    "marine",
    "geocoding",
    "alerts",
    "early-warning",
    "webhooks",
    "typescript",
    "4shadow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/similie/4Shadow-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://4shadow.io",
  "bugs": {
    "url": "https://github.com/similie/4Shadow-js/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
