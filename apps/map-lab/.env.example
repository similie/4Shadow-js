# Copy to .env.local (git-ignored) and fill in. Never commit a real key.

# Your 4Shadow API key. The lab's server adds it to each request, so it never reaches the browser.
FORESHADOW_API_KEY=
# The API behind the lab's server. Default: https://api.4shadow.io
# FORESHADOW_API_URL=https://api.4shadow.io
# Where 4Shadow sends this lab's webhooks (ending in /hooks/4shadow). Default: the `npm run tunnel` address.
# WEBHOOK_URL=https://your-name.ngrok-free.app/hooks/4shadow

# Or, for the map only, call an API straight from the browser. Alerts still go through the lab's
# server. A key set here is sent from the browser, so use a test key.
# VITE_FORESHADOW_URL=https://api.4shadow.io
# VITE_FORESHADOW_KEY=
