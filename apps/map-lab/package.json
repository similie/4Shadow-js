{
  "name": "map-lab",
  "private": true,
  "version": "0.0.1",
  "description": "Local dev app for 4Shadow maps: WebGL weather layers, wind particles, isobars, point forecasts",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview",
    "tunnel": "node scripts/tunnel.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run"
  },
  "dependencies": {
    "@similie/4shadow": "0.1.0",
    "d3-contour": "^4.0.3",
    "maplibre-gl": "^6.18.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-contour": "^3.0.6",
    "@types/geojson": "^7946.0.16",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
